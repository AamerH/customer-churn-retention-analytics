      <column caption='Tenure Group' datatype='string' name='[Calculation_0697956358336515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0-12 Months&quot;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;13-24 Months&quot;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;25-48 Months&quot;&#10;ELSE &quot;49+ Months&quot;&#10;END' />
      </column>

        <zone forceUpdate='true' h='31500' id='19' type-v2='text' w='38308' x='64000' y='68500'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Key Insights</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• Month-to-month customers have the highest churn at 42.71%.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• Customers in their first 12 months have a 47.44% churn rate.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• Fiber-optic customers have a 41.89% churn rate.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• Churned customers represent $139,130.85 in monthly charges.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Recommended Actions</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Prioritize retention offers for new and month-to-month customers. Investigate the elevated churn among fiber-optic customers and identify potential service or pricing drivers.</run>
          </formatted-text>
        </zone>
        <zone h='23000' id='20' name='Churned Customers KPI' w='17462' x='85308' y='13500' />
